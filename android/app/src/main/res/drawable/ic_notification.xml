<?xml version="1.0" encoding="utf-8"?>
<!--
  Isolation 通知小图标：与应用图标一致的"双圆角矩形嵌套线框"风格。
  注意：Android 通知小图标只使用 Alpha 通道，系统统一渲染为白色，
  因此这里使用透明背景 + 白色线框。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 外层圆角矩形线框 -->
    <path
        android:pathData="M7,2H17Q22,2 22,7V17Q22,22 17,22H7Q2,22 2,17V7Q2,2 7,2Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- 内层圆角矩形线框 -->
    <path
        android:pathData="M9,6H15Q18,6 18,9V15Q18,18 15,18H9Q6,18 6,15V9Q6,6 9,6Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />
</vector>
